[Unit]
Description=Tetracubed API (FastAPI + Pulumi Automation)
# Ordering only — a --user unit can't hard-depend on the system network target,
# but Restart=always covers a start before the network is up.
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tetracubed-api
ExecStart=%h/tetracubed-api/deploy/run.sh
Restart=always
RestartSec=10

[Install]
# default.target is the user-session equivalent of multi-user.target.
WantedBy=default.target
