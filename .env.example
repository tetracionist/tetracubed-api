# Auth — JSON map of {username: {username, hashed_password, ...}} (see User/UserInDB in main.py)
USERS_DB={"alice":{"username":"alice","hashed_password":"$argon2id$..."}}

# JWT signing secret (HS256)
JWT_SECRET_KEY=replace-me

# Pulumi
# Personal access token from https://app.pulumi.com/account/tokens — used for state + ESC
PULUMI_ACCESS_TOKEN=pul-...
# Stack name; defaults to "dev" if unset
PULUMI_STACK_NAME=dev

# AWS — boto3 + the Pulumi AWS provider both read these
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=eu-west-2

# Optional config overrides (otherwise read from Pulumi ESC env "tetracubed-api/dev")
# VPC_CIDR=
# ECS_CLUSTER_NAME=
# ECS_TASK_CPU=
# ECS_TASK_MEMORY=
# ECS_CPU_ARCHITECTURE=
# MINECRAFT_VERSION=
# MINECRAFT_MAX_PLAYERS=
# RCON_STARTUP_COMMANDS=
# MODRINTH_PROJECTS=
# OPS_LIST=
